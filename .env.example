# xTB binary (default: search PATH for `xtb`)
XTB_BIN=xtb

# Data root for run logs and reports
XTB_DATA_DIR=./data

# Optional: Gemini MAS client enrichment (sections 10–14)
# Copy to .env.local and set your key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
